# Plantilla de variables de entorno para el stack PartFinder 360.
# Copiar a /opt/partfinder360/.env y rellenar con valores reales.
# NO commitear el .env real (ya esta en .gitignore).

# ==== Boostr ====
BOOSTR_API_KEY=tu_api_key_boostr_aqui

# ==== PRT Service (Node.js en el host, puerto 3090) ====
PRT_SERVICE_URL=http://host.docker.internal:3090

# ==== Admin API ====
ADMIN_JWT_SECRET=genera_un_secret_largo_aleatorio
ADMIN_USERS=admin@tudominio.com:$2b$12$hash_bcrypt_de_la_password
